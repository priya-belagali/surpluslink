# Copy this file to ".env" and edit. ".env" is git-ignored.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
APP_TIMEZONE=Asia/Kolkata

# Database. Leave blank to use a local SQLite file. For a hosted database use, for example:
# DATABASE_URL=postgresql+psycopg2://user:password@host/dbname
DATABASE_URL=

# Matching. A listing is offered to one NGO at a time for this long before moving on.
# Use 90 seconds on stage so the cascade is visible; leave blank for 15 minutes.
OFFER_TIMEOUT_SEC=
OFFER_TIMEOUT_MIN=15
MAX_MATCH_RADIUS_KM=30
TICK_SECONDS=10

# Matching that learns from past offers (silent, declined, accepted, and how fast). Set false for distance rules only.
ADAPTIVE_MATCHING=true

# Optional: lets donors describe food in a sentence and have a language model pre-fill the form.
# Leave blank to switch it off. The text typed is sent to the Anthropic API.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# true = every NGO sees every open listing at once. This switches the cascade OFF, so leave it false for the demo.
DEMO_MODE=false
# true = fill an empty database with clearly labelled demo accounts and history (password demo123).
SEED_DEMO_ON_EMPTY=false

# Address search (OpenStreetMap Nominatim) asks for a way to contact you in the User-Agent
GEOCODE_CONTACT=you@example.com

# Coverage map (run: py scripts/fetch_places.py)
COVERAGE_CITY=Mysuru
COVERAGE_RADIUS_KM=8

# Optional real alerts through Twilio. Leave blank to use in-app notifications only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A WhatsApp sandbox sender such as whatsapp:+14155238886, or an SMS number such as +1415xxxxxxx
TWILIO_FROM=

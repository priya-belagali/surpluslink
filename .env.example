# Copy this file to ".env" and edit. ".env" is git-ignored.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
APP_TIMEZONE=Asia/Kolkata
OFFER_TIMEOUT_MIN=15
MAX_MATCH_RADIUS_KM=30

# Optional real alerts via Twilio (leave blank to use in-app notifications only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# SMS number like +1415xxxxxxx, or a WhatsApp sender like whatsapp:+14155238886
TWILIO_FROM=
